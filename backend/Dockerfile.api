# Build context: repository root (../../ from docs/deploy)
FROM node:22-alpine AS admin-builder

WORKDIR /src/web
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

# 先只拷依赖清单与补丁，让 pnpm install 层不被业务源码改动击穿缓存
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/patches ./patches
COPY web/admin/package.json ./admin/package.json
COPY web/app/package.json ./app/package.json
COPY web/packages/icons/package.json ./packages/icons/package.json
COPY web/packages/themes/package.json ./packages/themes/package.json
COPY web/packages/ui/package.json ./packages/ui/package.json

RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm install --frozen-lockfile

COPY web/ ./

RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter panda-wiki-admin build

FROM --platform=$BUILDPLATFORM golang:1.26.4-alpine AS builder

WORKDIR /src/backend
ENV CGO_ENABLED=0

COPY backend/go.mod backend/go.sum ./
COPY backend/third_party ./third_party
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend/ .

ARG TARGETOS TARGETARCH VERSION
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" -o /build/panda-wiki-api cmd/api/main.go cmd/api/wire_gen.go \
    && GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-s -w -extldflags '-static' -X github.com/chaitin/panda-wiki/telemetry.Version=${VERSION}" -o /build/panda-wiki-migrate cmd/migrate/main.go cmd/migrate/wire_gen.go

FROM alpine:3.21 AS api

# 不做 apk upgrade：基础包随镜像固定，保证构建产物可复现
RUN apk add --no-cache ca-certificates tzdata \
    && update-ca-certificates 2>/dev/null || true

WORKDIR /app

COPY --from=builder /build/panda-wiki-api /app/panda-wiki-api
COPY --from=builder /build/panda-wiki-migrate /app/panda-wiki-migrate
COPY --from=builder /src/backend/store/pg/migration /app/migration
COPY --from=admin-builder /src/web/admin/dist /app/admin/dist

CMD ["sh", "-c", "/app/panda-wiki-migrate && /app/panda-wiki-api"]
