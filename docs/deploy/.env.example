# 复制为 .env 后修改，或直接运行: ./generate-env.sh
# 必填（generate-env.sh 会自动生成随机值）:
POSTGRES_PASSWORD=change_me_postgres
REDIS_PASSWORD=change_me_redis
S3_ACCESS_KEY=s3panda-wiki
S3_SECRET_KEY=change_me_s3
NATS_PASSWORD=change_me_nats
QDRANT_API_KEY=change_me_qdrant
JWT_SECRET=change_me_jwt
ADMIN_PASSWORD=change_me_admin

# 可选 — 生产经 Caddy 按知识库路由时可留空；仅直连 App 调试时需要
DEV_KB_ID=

# Image 模式（Linux 生产推荐）
PANDAWIKI_IMAGE_REPO=docker.io/caodanv
PANDAWIKI_IMAGE_TAG=latest

# API 内嵌 MQ 消费者与定时任务（默认 1；独立 Consumer 见 compose profile split-worker）
RUN_WORKER=1
# 管理端由 API 内嵌 HTTPS 服务（默认 1；回退独立 Admin 容器见 profile legacy-admin）
ADMIN_ENABLED=1
