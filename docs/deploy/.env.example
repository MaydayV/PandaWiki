# 复制为 .env 后修改，或直接运行: ./generate-env.sh
# 必填（generate-env.sh 会自动生成随机值）:
POSTGRES_PASSWORD=change_me_postgres
REDIS_PASSWORD=change_me_redis
S3_ACCESS_KEY=your_oss_access_key
S3_SECRET_KEY=your_oss_secret_key
S3_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=your-bucket-name
S3_REGION=oss-cn-hangzhou
S3_USE_SSL=1
# OSS 公网访问根 URL（桶域名或 CDN）；留空则按 endpoint+bucket 自动拼接
S3_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
NATS_PASSWORD=change_me_nats
JWT_SECRET=change_me_jwt
ADMIN_PASSWORD=change_me_admin

# 可选 — 生产经 Caddy 按知识库路由时可留空；仅直连 App 调试时需要
DEV_KB_ID=

# Image 模式（Linux 生产推荐）
PANDAWIKI_IMAGE_REPO=docker.io/caodanv
PANDAWIKI_IMAGE_TAG=latest

# API 内嵌 MQ 消费者与定时任务（默认 1）
RUN_WORKER=1
# 管理端由 API 内嵌 HTTPS 服务（默认 1，端口 2443）
ADMIN_ENABLED=1

# RAG 后端：Postgres pgvector
RAG_PROVIDER=pg
# 须与 full_fresh_deploy.sql 中 rag_chunks.embedding 维度一致（默认 1024）
RAG_PG_EMBEDDING_DIM=1024
